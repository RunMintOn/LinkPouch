{
  "manifest_version": 3,
  "name": "LinkPouch",
  "description": "Save links now and read them later.",
  "version": "0.1.0",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "activeTab", "favicon"],
  "action": {
    "default_title": "Save to LinkPouch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "commands": {
    "capture-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Capture the current page"
    },
    "open-reading-queue": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "Open or focus LinkPouch"
    }
  }
}
